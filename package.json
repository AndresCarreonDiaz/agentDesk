{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDesk: a front desk for AI agents that learns from every visit. Includes the Harbor Goods demo store.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/store/index.ts",
    "dev:local": "tsx src/store/dev-local.ts",
    "start": "tsx src/store/index.ts",
    "seed": "tsx src/store/seed.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
