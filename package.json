{
  "name": "harbor-goods",
  "version": "0.1.0",
  "private": true,
  "description": "Harbor Goods: the demo store AgentDesk learns from. All data in MongoDB Atlas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
