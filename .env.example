# Copy to .env and fill in. .env is git-ignored and blocked by the pre-commit hook.

# Required: the Atlas cluster where AgentDesk keeps its memory (today: the hackathon sandbox)
MONGODB_URI=

# Required: one LLM key. Checked in this order: Gemini, Anthropic, OpenAI.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: Voyage embeddings. Without it, Gemini makes the embeddings.
# Create one in Atlas: project > AI Model APIs > Create model API key (works on ai.mongodb.com).
# Set it BEFORE a database first starts: each AgentDesk database locks its embedding provider then.
# VOYAGE_API_KEY=

# Optional overrides
# AGENTDESK_DB=agentdesk_yourname   # use your own database while building
# AGENTDESK_SITE_ID=
# AGENTDESK_MODEL=gemini-3.8-flash
# AGENTDESK_AUTOPILOT=off          # start a new database with autopilot off (default on; money always asks)

# Demo store (src/store)
# MONGODB_DB_STORE=harbor          # the store's own database on the same cluster
# PORT=3000
# SITE_URL=http://localhost:3000
# AGENTDESK=off                    # run the store without AgentDesk installed
