# Hackathon Atlas Sandbox cluster only (finalist rule). Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<sandbox-cluster>.mongodb.net/?retryWrites=true&w=majority

# AgentDesk (CONTRACT.md section 1). While building, use your own AGENTDESK_DB (e.g. agentdesk_yourname).
AGENTDESK_DB=agentdesk
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Demo store
MONGODB_DB_STORE=harbor
PORT=3000
SITE_URL=http://localhost:3000
# AGENTDESK=off   # run the store without AgentDesk installed
